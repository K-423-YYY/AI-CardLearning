# 运行环境：dev / prod
APP_ENV=dev
APP_SECRET_KEY=请替换为随机长字符串
APP_PORT=8000

# 数据库
DATABASE_PATH=./data/app.db

# 邮件 SMTP（本地开发留空即自动使用控制台打印验证码；生产环境必须配置）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=1
EMAIL_CODE_LIMIT=10

# 默认 AI（DeepSeek，用户可在设置页用自己的 Key）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
