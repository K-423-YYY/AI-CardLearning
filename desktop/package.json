{
  "name": "ai-learn-desktop",
  "version": "0.1.0",
  "description": "AI 闯关学习 Windows 桌面版外壳",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.3.0"
  },
  "build": {
    "appId": "com.ailearn.local",
    "productName": "AI闯关学习",
    "files": [
      "main.js",
      "preload.js",
      "../app/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "uninstaller.nsh"
    }
  }
}
